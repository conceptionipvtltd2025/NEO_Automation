{
  "name": "neo-automation-server",
  "version": "1.0.0",
  "private": true,
  "description": "REST API + MySQL backend for the Neo Automation website & admin panel",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/index.js",
    "seed": "tsx src/seed.ts",
    "backfill:industries": "tsx src/backfillIndustries.ts",
    "sync:catalogue": "tsx src/syncCatalogue.ts",
    "check:brands": "tsx src/checkBrandLines.ts",
    "_comment_prod": "On a production install (no devDependencies) tsx is absent — use the compiled build instead:",
    "backfill:industries:prod": "node dist/backfillIndustries.js",
    "sync:catalogue:prod": "node dist/syncCatalogue.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.11.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
