# ── Server ────────────────────────────────────────────────
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server, your prod site).
# Use * to allow any origin (fine for local dev).
CORS_ORIGIN=http://localhost:5173

# Public, browser-reachable URL that maps to the backend's ./uploads folder.
# Product images are saved there and this URL is stored with the product.
#   • Local dev:  http://localhost:4000/uploads
#   • Production: https://cidev.in/neo_website_backend/uploads
# If left unset, a relative "/uploads" is used (only works when the frontend and
# backend share the same origin/base path).
PUBLIC_UPLOADS_URL=http://localhost:4000/uploads

# ── MySQL ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=neo_automation

# ── Auth ──────────────────────────────────────────────────
# Change this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Seed admin account (created on first boot if no admin exists).
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=neo@2026
